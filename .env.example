# TIVA Founder OS - Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to git!

# ============================================================
# REQUIRED - Core AI Providers
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ============================================================
# REQUIRED - Zoho (50 Apps) - Get from https://api-console.zoho.com/
# ============================================================
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=your-refresh-token

# ============================================================
# REQUIRED - AnythingLLM
# ============================================================
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=your-anythingllm-api-key

# ============================================================
# OPTIONAL - Additional MCP Servers
# ============================================================
# Slack: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_TEAM_ID=T123456

# Notion: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your-key

# Linear: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_your-key

# PostgreSQL
POSTGRES_CONNECTION_STRING=postgresql://user:pass@host:5432/db

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Kubernetes
KUBECONFIG=/path/to/kubeconfig

# Docker (uses local socket)
# No env vars needed

# ============================================================
# OPTIONAL - LLM Providers for AnythingLLM
# ============================================================
GEMINI_API_KEY=your-gemini-key
MISTRAL_API_KEY=your-mistral-key
GROQ_API_KEY=your-groq-key
COHERE_API_KEY=your-cohere-key
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ============================================================
# OPTIONAL - AnythingLLM Config
# ============================================================
JWT_SECRET=$(openssl rand -base64 32)
ADMIN_EMAIL=admin@tiva.local
ADMIN_PASSWORD=TIVA@FounderOS2026!
POSTGRES_PASSWORD=$(openssl rand -base64 32)

# ============================================================
# OPTIONAL - Cloudflare (for Workers deployment)
# ============================================================
CLOUDFLARE_API_TOKEN=your-cf-token
CLOUDFLARE_ACCOUNT_ID=your-account-id